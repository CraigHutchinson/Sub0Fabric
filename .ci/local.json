{
  "version": 1,
  "description": "Sub0Fabric local checks (CraigHutchinson/.github docs/ci-strategy.md); run: python <.github repo>/tools/ci/local_ci.py --level quick|full. The full level's perf step is timing: it runs on mains power only, and never in hosted CI.",
  "levels": {
    "quick": {
      "steps": [
        {
          "name": "gcc",
          "compiler": "gcc",
          "commands": [
            "cmake --preset default -B {builddir} -G Ninja -DCMAKE_C_COMPILER={cc} -DCMAKE_CXX_COMPILER={cxx}",
            "cmake --build {builddir} -j {jobs}",
            "ctest --preset quick --test-dir {builddir}"
          ]
        },
        {
          "name": "clang",
          "compiler": "clang",
          "optional": true,
          "commands": [
            "cmake --preset default -B {builddir} -G Ninja -DCMAKE_C_COMPILER={cc} -DCMAKE_CXX_COMPILER={cxx}",
            "cmake --build {builddir} -j {jobs}",
            "ctest --preset quick --test-dir {builddir}"
          ]
        },
        {
          "name": "private-names",
          "commands": [
            "{python} {ci_dir}/private_names.py --staged --repo {repo}",
            "{python} {ci_dir}/private_names.py --tree --repo {repo}"
          ]
        },
        {
          "name": "hook-check",
          "commands": [
            "{python} {ci_dir}/hook_check.py --repo {repo}"
          ]
        }
      ]
    },
    "full": {
      "steps": [
        {
          "name": "gcc",
          "compiler": "gcc",
          "commands": [
            "cmake --preset default -B {builddir} -G Ninja -DCMAKE_C_COMPILER={cc} -DCMAKE_CXX_COMPILER={cxx}",
            "cmake --build {builddir} -j {jobs}",
            "ctest --preset full --test-dir {builddir} --timeout 600"
          ]
        },
        {
          "name": "clang",
          "compiler": "clang",
          "optional": true,
          "commands": [
            "cmake --preset default -B {builddir} -G Ninja -DCMAKE_C_COMPILER={cc} -DCMAKE_CXX_COMPILER={cxx}",
            "cmake --build {builddir} -j {jobs}",
            "ctest --preset full --test-dir {builddir} --timeout 600"
          ]
        },
        {
          "name": "perf",
          "compiler": "gcc",
          "timing": true,
          "perf_outcome": "{builddir}/perf-outcome.json",
          "commands": [
            "cmake --preset default -B {builddir} -G Ninja -DCMAKE_C_COMPILER={cc} -DCMAKE_CXX_COMPILER={cxx} -DSUB0MATH_PERF_GIT_HOOKS=ON",
            "cmake --build {builddir} -j {jobs}",
            [
              "{python}",
              "-c",
              "import subprocess,sys;sys.exit(subprocess.run(sys.argv[2:],stdout=open(sys.argv[1],'w')).returncode)",
              "{builddir}/perf-outcome.json",
              "{python}",
              "{sub0math_tooling}/bench_check.py",
              "gate",
              "--level",
              "full",
              "--format",
              "json"
            ]
          ]
        },
        {
          "name": "private-names",
          "commands": [
            "{python} {ci_dir}/private_names.py --staged --repo {repo}",
            "{python} {ci_dir}/private_names.py --tree --repo {repo}"
          ]
        }
      ]
    }
  }
}
