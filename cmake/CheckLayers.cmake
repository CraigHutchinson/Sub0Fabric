# Layering check: a file under src/<layer> or include/sub0fabric/<layer> may include "sub0fabric/<other>/..." only for its own or a lower layer;
# <simdjson> never in a public header; the pure layer includes no I/O header and no Sub0Platform header, and reads no clock.
# Run as: cmake -DSRC_DIR=<repo> -P CheckLayers.cmake
if(NOT SRC_DIR OR NOT EXISTS "${SRC_DIR}/CMakeLists.txt")
  message(FATAL_ERROR "layering check: pass -DSRC_DIR=<repository root> (got '${SRC_DIR}')")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/Layers.cmake")
set(bad "")
set(count 0)
set(index 0)
foreach(layer ${SUB0FABRIC_LAYERS})
  set(rank_${layer} ${index})
  math(EXPR index "${index} + 1")
endforeach()
foreach(layer ${SUB0FABRIC_LAYERS})
  file(GLOB_RECURSE files "${SRC_DIR}/src/${layer}/*" "${SRC_DIR}/include/sub0fabric/${layer}/*")
  foreach(f ${files})
    math(EXPR count "${count} + 1")
    file(STRINGS "${f}" lines REGEX "^#include")
    foreach(l ${lines})
      if(l MATCHES "^#include [\"<]sub0fabric/([a-z_0-9]+)/")
        set(other ${CMAKE_MATCH_1})
        if(NOT DEFINED rank_${other})
          list(APPEND bad "${f}: includes unknown layer '${other}'")
        elseif(rank_${other} GREATER rank_${layer})
          list(APPEND bad "${f}: layer ${layer} includes upward layer ${other}")
        endif()
      endif()
      if(l MATCHES "^#include <simdjson" AND f MATCHES "/include/")
        list(APPEND bad "${f}: <simdjson> must stay out of public headers")
      endif()
      if(layer STREQUAL "pure")
        if(l MATCHES "^#include <(filesystem|fstream|cstdio|thread|chrono|iostream)>" OR l MATCHES "^#include [\"<]sub0platform/")
          list(APPEND bad "${f}: the pure layer does no I/O and reads no clock: ${l}")
        endif()
      endif()
    endforeach()
  endforeach()
endforeach()
if(bad)
  string(REPLACE ";" "\n  " msg "${bad}")
  message(FATAL_ERROR "layering violations:\n  ${msg}")
endif()
message(STATUS "layering ok (${count} files)")
