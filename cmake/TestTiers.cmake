# Test tiers and areas (CraigHutchinson/.github docs/ci-strategy.md, "Test labels"). Every ctest test carries exactly one TIER label and one
# area:<name> label; the configure fails otherwise. Tiers: smoke (CI on every push, `ctest --preset quick`), full (long suites, `--preset full`),
# local (needs this machine, never CI). The timing run has its own label, timing, and is outside the tiers.
include_guard(GLOBAL)
set(SUB0FABRIC_TEST_TIERS smoke full local)
set(SUB0FABRIC_TEST_AREAS structure pure io bench)

# sub0fabric_label_tests(AREA x TIER t [SLOW] TARGETS name...)
function(sub0fabric_label_tests)
  cmake_parse_arguments(L "SLOW" "AREA;TIER" "TARGETS" ${ARGN})
  foreach(test ${L_TARGETS})
    if(NOT TEST ${test})
      continue()
    endif()
    set(labels ${L_TIER} "area:${L_AREA}")
    if(L_SLOW)
      list(APPEND labels "cost:slow")
    endif()
    set_property(TEST ${test} APPEND PROPERTY LABELS ${labels})
  endforeach()
endfunction()

# Checked after every add_test: a new test cannot be left out.
function(sub0fabric_check_labels)
  get_property(allTests DIRECTORY ${CMAKE_SOURCE_DIR} PROPERTY TESTS)
  set(bad "")
  string(REPLACE ";" "|" tierRe "${SUB0FABRIC_TEST_TIERS}")
  string(REPLACE ";" "|" areaRe "${SUB0FABRIC_TEST_AREAS}")
  foreach(test ${allTests})
    get_property(labels TEST ${test} PROPERTY LABELS)
    list(REMOVE_DUPLICATES labels)   # the benchmark tooling already labels its tests smoke
    if("timing" IN_LIST labels)
      continue()
    endif()
    set(tiers ${labels})
    list(FILTER tiers INCLUDE REGEX "^(${tierRe})$")
    set(areas ${labels})
    list(FILTER areas INCLUDE REGEX "^area:(${areaRe})$")
    list(LENGTH tiers nt)
    list(LENGTH areas na)
    if(NOT nt EQUAL 1 OR NOT na EQUAL 1)
      list(APPEND bad "${test} (labels: ${labels})")
    endif()
  endforeach()
  if(bad)
    string(REPLACE ";" "; " msg "${bad}")
    message(FATAL_ERROR "every test needs one tier (${SUB0FABRIC_TEST_TIERS}) and one area:<${SUB0FABRIC_TEST_AREAS}>: ${msg}")
  endif()
endfunction()
